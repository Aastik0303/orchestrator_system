# Copy to .env and fill in. Never commit .env.

# --- Runtime -------------------------------------------------------------
APP_ENV=development            # production refuses AUTH_MODE=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication --------------------------------------------------------
# dev: trusts X-User-Id / user_id (local only). api_key: user derived from key.
AUTH_MODE=dev
# Comma-separated "<key-or-sha256>:<user_id>" pairs (prefer sha256 hex digests).
API_KEYS=

# --- Model provider ----------------------------------------------------------
LLM_PROVIDER=groq              # groq | fake (offline tests/benchmarks) | none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1200
FAKE_LLM_LATENCY_MS=0

# --- Persistence / infrastructure -------------------------------------------
# Empty DATABASE_URL = local SQLite at RUNTIME_DATABASE_PATH.
DATABASE_URL=
RUNTIME_DATABASE_PATH=storage/runtime.db
DATABASE_POOL_SIZE=10
DATABASE_POOL_PRE_PING=true      # no measurable cost in benchmarks; protects against stale connections
DATABASE_POOL_RECYCLE_SECONDS=1800
POSTGRES_PASSWORD=change-me     # used by docker-compose only
REDIS_URL=                      # optional: shared cache + rate limits
STORAGE_ROOT=storage
WORKER_MODE=inprocess           # inprocess | external (python -m app.workers.runner)

# --- Retrieval -------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_TORCH_THREADS=1       # best throughput for many small concurrent queries (see PERFORMANCE.md)
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=140
RAG_TOP_K=5
VECTOR_BACKEND=auto             # auto: pgvector on PostgreSQL when available, else NumPy | numpy | pgvector
RAG_SIMILARITY_THRESHOLD=0.30         # calibrated for all-MiniLM-L6-v2 (see EVALUATION.md)
RAG_RELATIVE_SCORE_CUTOFF=0.5
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_CHUNKS_PER_DOCUMENT=3

# --- Routing -----------------------------------------------------------------
ROUTER_CONFIDENCE_THRESHOLD=0.65
ROUTER_LLM_ENABLED=true
GENERAL_CHAT_ENABLED=true       # false = refuse off-topic requests
EVALUATION_PASSING_SCORE=75

# --- Workflow budgets --------------------------------------------------------
MAX_PLAN_NODES=20               # max_steps
MAX_PLAN_DEPTH=8
MAX_EXECUTION_SECONDS=180       # max_runtime
MAX_TOOL_CALLS=25
MAX_TOKENS_PER_RUN=60000
MAX_LLM_CALLS_PER_RUN=12
MAX_RETRIES_PER_RUN=6
MAX_PARALLEL_STEPS=4
STEP_INPUT_MAX_CHARS=4000

# --- Guardrails / abuse prevention -----------------------------------------
GUARDRAIL_MODE=enforce          # enforce | monitor
PII_REDACTION=standard          # standard (cards, SSN) | strict (+ email, phone)
MAX_MESSAGE_CHARS=20000
RATE_LIMIT_PER_MINUTE=30
MAX_ACTIVE_RUNS_PER_USER=3

# --- Sandboxed code execution ----------------------------------------------
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_MB=256
SANDBOX_MAX_OUTPUT_BYTES=20000

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_SIZE=20971520
MAX_FILES_PER_REQUEST=5

# --- Optional external MCP adapters -----------------------------------------
GITHUB_TOKEN=
WEB_SEARCH_API_KEY=

# --- Frontend development ----------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8002
VITE_API_KEY=
